# Addressables bundles are big binaries: store them in Git LFS (any platform folder: Android/, iOS/, ...).
*.bundle filter=lfs diff=lfs merge=lfs -text
# content.json, catalog_*.hash / catalog_*.bin stay normal files (small, and content.json must stay editable as text).
# Music is streamed by the game from music/ (see music.json). Keep the audio files in LFS too.
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.m4a filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
